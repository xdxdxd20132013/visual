-- КОНТЕЙНЕРИ ДЛЯ РОЗДІЛІВ (ВКЛАДОК)
local CheatsFrame = Instance.new("Frame")
local VisualFrame = Instance.new("Frame")
local SettingsFrame = Instance.new("Frame")

-- Кнопки всередині вкладок (ініціалізація нових елементів)
local GraySkyBtn = Instance.new("TextButton")
local AntiShakeBtn = Instance.new("TextButton")

-- НАЛАТУВАННЯ ЗБЕРЕЖЕННЯ (Пам'ять читу між серверами)
local HttpService = game:GetService("HttpService")
local fileName = "BloxFruits_Xeno_Config.json"

-- Стандартні налаштування (якщо файл конфігу ще не створено)
_G.Config = {
    FlySpeed = 250,
    GraySky = false,
    AntiShake = false,
    ChestFarm = false,
    FlyMode = false,
    FruitEsp = false
}

-- Функція завантаження збережених налаштувань
local function loadSettings()
    if readfile and isfile and isfile(fileName) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(fileName))
        end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do _G.Config[k] = v end
        end
    end
end

-- Функція збереження змін у файл
local function saveSettings()
    if writefile then
        pcall(function()
            writefile(fileName, HttpService:JSONEncode(_G.Config))
        end)
    end
end

-- ЗАВАНТАЖУЄМО НАЛАШТУВАННЯ ОДРАЗУ ПРИ ЗАПУСКУ
loadSettings()

-- ФУНКЦІЯ СТВОРЕННЯ КОНТЕЙНЕРІВ ДЛЯ ВКЛАДОК
local function createTabFrame(f, name, visible)
    f.Name = name 
    f.Parent = MainFrame
    f.BackgroundTransparency = 1
    f.Position = UDim2.new(0, 0, 0.28, 0) 
    f.Size = UDim2.new(1, 0, 0.72, 0) 
    f.Visible = visible
    
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder 
    layout.Padding = UDim.new(0, 5)
    layout.Parent = f
    
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 4) 
    padding.PaddingLeft = UDim.new(0, 10) 
    padding.PaddingRight = UDim.new(0, 10)
    padding.Parent = f
end

createTabFrame(CheatsFrame, "CheatsSection", true)
createTabFrame(VisualFrame, "VisualSection", false)
createTabFrame(SettingsFrame, "SettingsSection", false)

-- ШАБЛОН ДЛЯ КНОПОК ПЕРЕМИКАННЯ ВКЛАДОК
local function switchTab(activeFrame, activeBtn)
    CheatsFrame.Visible = (activeFrame == CheatsFrame)
    VisualFrame.Visible = (activeFrame == VisualFrame)
    SettingsFrame.Visible = (activeFrame == SettingsFrame)
    
    CheatsTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    VisualTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    SettingsTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
end

CheatsTabBtn.MouseButton1Click:Connect(function() switchTab(CheatsFrame, CheatsTabBtn) end)
VisualTabBtn.MouseButton1Click:Connect(function() switchTab(VisualFrame, VisualTabBtn) end)
SettingsTabBtn.MouseButton1Click:Connect(function() switchTab(SettingsFrame, SettingsTabBtn) end)


