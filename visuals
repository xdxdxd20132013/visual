-- ЛОГІКА ДЛЯ РОЗДІЛУ «ВІЗУАЛИ»
-----------------------------------------------------------

-- 1. СІРЕ НЕБО (Gray Sky / FPS Boost)
styleButton(GraySkyBtn, VisualFrame, "🔘... Скарчується стан")

local function updateGraySkyVisual()
    if _G.Config.GraySky then
        GraySkyBtn.Text = "🟢 Сіре Небо: ON"
        GraySkyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        local sky = game:GetService("Lighting"):FindFirstChildOfClass("Sky")
        if sky then sky:Destroy() end
        game:GetService("Lighting").ClockTime = 12
    else
        GraySkyBtn.Text = "🔘 Сіре Небо: OFF"
        GraySkyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    end
end

GraySkyBtn.MouseButton1Click:Connect(function()
    _G.Config.GraySky = not _G.Config.GraySky
    saveSettings() 
    updateGraySkyVisual()
end)

-- 2. АНТИ-ТРЯСІННЯ ЕКРАНУ (Anti Screen Shake)
styleButton(AntiShakeBtn, VisualFrame, "🔘... Скарчується стан")

local function updateAntiShakeLogic()
    if _G.Config.AntiShake then
        AntiShakeBtn.Text = "🟢 Anti Screen Shake: ON"
        AntiShakeBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
    else
        AntiShakeBtn.Text = "🔘 Тнясіння екрану: OFF"
        AntiShakeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    end
end

AntiShakeBtn.MouseButton1Click:Connect(function()
    _G.Config.AntiShake = not _G.Config.AntiShake
    saveSettings() 
    updateAntiShakeLogic()
end)

-- Жорстке блокування трясіння камери в Blox Fruits
task.spawn(function()
    while task.wait(0.1) do
        if _G.Config.AntiShake then
            pcall(function()
                if game:GetService("Players").LocalPlayer:FindFirstChild("Settings") and game:GetService("Players").LocalPlayer.Settings:FindFirstChild("Camera Shake") then
                    game:GetService("Players").LocalPlayer.Settings["Camera Shake"].Value = false
                end
                for _, v in pairs(workspace.CurrentCamera:GetChildren()) do
                    if v:IsA("Script") or v.Name:find("Shake") or v.Name:find("Cam") then
                        v:Destroy()
                    end
                end
            end)
        end
    end
end)

-- Авто-запуск стану кнопок при старті
updateGraySkyVisual()
updateAntiShakeLogic()

