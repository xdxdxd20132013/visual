NightBtn.MouseButton1Click:Connect(function() _G.Config.VisualTime = "Night"; _G.Config.GraySky = false; applyVisualTime() end)
DefaultTimeBtn.MouseButton1Click:Connect(function() _G.Config.VisualTime = "Default"; _G.Config.GraySky = false; Lighting.ClockTime = 12 end)

task.spawn(function()
    while _G.ScriptRunning and task.wait(0.01) do
        applyVisualTime()
    end
end)

-- 2. СІРЕ НЕБО (Вмикання та повне повернення назад)
local function updateGraySkyVisual()
    if _G.Config.GraySky then
        GraySkyBtn.Text = "🟢 Сіре Небо: ON"; GraySkyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        _G.Config.VisualTime = "Default"; Lighting.ClockTime = 12; Lighting.FogEnd = 9e9
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not originalMaterials[obj] then
                originalMaterials[obj] = {Material = obj.Material, Color = obj.Color}
                obj.Material = Enum.Material.SmoothPlastic
                obj.Color = Color3.fromRGB(120, 120, 120)
            end
        end
    else
        GraySkyBtn.Text = "🔘 Сіре Небо: OFF"; GraySkyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        -- Повертаємо графіку Blox Fruits назад
        for obj, data in pairs(originalMaterials) do
            if obj and obj.Parent then
                obj.Material = data.Material
                obj.Color = data.Color
            end
        end
        table.clear(originalMaterials)
    end
end
GraySkyBtn.MouseButton1Click:Connect(function() _G.Config.GraySky = not _G.Config.GraySky; updateGraySkyVisual() end)

-- 3. АНТИ-ТРЯСІННЯ (Через ігрові налаштування)
local function updateAntiShakeLogic()
    AntiShakeBtn.Text = _G.Config.AntiShake and "🟢 Anti-Shake: ON" or "🔘 Трясіння екрану: OFF"
    AntiShakeBtn.BackgroundColor3 = _G.Config.AntiShake and Color3.fromRGB(39, 174, 96) or Color3.fromRGB(45, 45, 55)
end
AntiShakeBtn.MouseButton1Click:Connect(function() _G.Config.AntiShake = not _G.Config.AntiShake; updateAntiShakeLogic() end)

task.spawn(function()
    while _G.ScriptRunning and task.wait(0.1) do
        if _G.Config.AntiShake then
            pcall(function()
                local settingsShield = Player:FindFirstChild("Settings") or game:GetService("ReplicatedStorage"):FindFirstChild("Settings")
                if settingsShield and settingsShield:FindFirstChild("Camera Shake") then
                    settingsShield["Camera Shake"].Value = false
                end
                for _, v in pairs(workspace.CurrentCamera:GetChildren()) do
                    if v.Name:find("Shake") or v.Name:find("Cam") then v:Destroy() end
                end
            end)
        end
    end
end)

-- 4. КЛАСИЧНИЙ РОБОЧИЙ ПОЛІТ (Fly Mode за камерою)
_G.ActiveXenoBV = nil
_G.ActiveXenoBG = nil

local function toggleFly()
    local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if _G.Config.FlyMode then
        FlyBtn.Text = "Fly Mode: ON"; FlyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        if root then
            _G.ActiveXenoBV = Instance.new("BodyVelocity", root)
            _G.ActiveXenoBV.Name = "XenoFlyBV"; _G.ActiveXenoBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            _G.ActiveXenoBG = Instance.new("BodyGyro", root)
            _G.ActiveXenoBG.Name = "XenoFlyBG"; _G.ActiveXenoBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        end
    else
        FlyBtn.Text = "Fly Mode: OFF"; FlyBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
        if root then
            if root:FindFirstChild("XenoFlyBV") then root.XenoFlyBV:Destroy() end
            if root:FindFirstChild("XenoFlyBG") then root.XenoFlyBG:Destroy() end
        end
        if _G.ActiveXenoBV then _G.ActiveXenoBV:Destroy() end
        if _G.ActiveXenoBG then _G.ActiveXenoBG:Destroy() end
    end
end
FlyBtn.MouseButton1Click:Connect(function() _G.Config.FlyMode = not _G.Config.FlyMode; toggleFly() end)

task.spawn(function()
    while _G.ScriptRunning and task.wait(0.01) do
        if _G.Config.FlyMode and _G.ActiveXenoBV and _G.ActiveXenoBG and Player.Character then
            pcall(function()
                local hum = Player.Character:FindFirstChildOfClass("Humanoid")
                _G.ActiveXenoBG.CFrame = workspace.CurrentCamera.CFrame
                if hum and hum.MoveDirection.Magnitude > 0 then
                    _G.ActiveXenoBV.Velocity = workspace.CurrentCamera.CFrame.LookVector * _G.Config.FlySpeed
                else
                    _G.ActiveXenoBV.Velocity = Vector3.new(0, 0, 0)
                end
            end)
        end
    end
end)

