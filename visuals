-- 4. ПОЛІТ (Керування: WASD + Space вгору + Shift вниз)
_G.ActiveXenoBV = nil
_G.ActiveXenoBG = nil

local function toggleFly()
    local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if _G.Config.FlyMode then
        FlyBtn.Text = "Fly Mode: ON"; FlyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        if root then
            _G.ActiveXenoBV = Instance.new("BodyVelocity")
            _G.ActiveXenoBV.Name = "XenoFlyBV"
            _G.ActiveXenoBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            _G.ActiveXenoBV.Velocity = Vector3.new(0, 0, 0)
            _G.ActiveXenoBV.Parent = root
            
            _G.ActiveXenoBG = Instance.new("BodyGyro")
            _G.ActiveXenoBG.Name = "XenoFlyBG"
            _G.ActiveXenoBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            _G.ActiveXenoBG.CFrame = root.CFrame
            _G.ActiveXenoBG.Parent = root
        end
    else
        FlyBtn.Text = "Fly Mode: OFF"; FlyBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
        if root then
            if root:FindFirstChild("XenoFlyBV") then root.XenoFlyBV:Destroy() end
            if root:FindFirstChild("XenoFlyBG") then root.XenoFlyBG:Destroy() end
        end
        if _G.ActiveXenoBV then _G.ActiveXenoBV:Destroy() _G.ActiveXenoBV = nil end
        if _G.ActiveXenoBG then _G.ActiveXenoBG:Destroy() _G.ActiveXenoBG = nil end
    end
end
FlyBtn.MouseButton1Click:Connect(function() _G.Config.FlyMode = not _G.Config.FlyMode; toggleFly() end)

-- Цикл розрахунку напрямку WASD + клавіш висоти
task.spawn(function()
    while _G.ScriptRunning and task.wait(0.01) do
        if _G.Config.FlyMode and _G.ActiveXenoBV and _G.ActiveXenoBG and Player.Character then
            pcall(function()
                local hum = Player.Character:FindFirstChildOfClass("Humanoid")
                local root = Player.Character:FindFirstChild("HumanoidRootPart")
                
                if hum and root then
                    local camLook = workspace.CurrentCamera.CFrame.LookVector
                    _G.ActiveXenoBG.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(camLook.X, 0, camLook.Z))
                    
                    local moveDir = hum.MoveDirection * _G.Config.FlySpeed
                    local verticalSpeed = 0
                    
                    if UIS:IsKeyDown(Enum.KeyCode.Space) then
                        verticalSpeed = _G.Config.FlySpeed
                    elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift) then
                        verticalSpeed = -_G.Config.FlySpeed
                    end
                    
                    _G.ActiveXenoBV.Velocity = Vector3.new(moveDir.X, verticalSpeed, moveDir.Z)
                end
            end)
        end
    end
end)

