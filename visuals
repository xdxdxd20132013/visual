-- 5. РОБОЧИЙ ПОЛІТ (Fly Mode)
local currentBV = nil
local currentBG = nil

local function toggleFly()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if _G.Config.FlyMode then
        FlyBtn.Text = "Fly Mode: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        if root then
            currentBV = Instance.new("BodyVelocity")
            currentBV.Name = "XenoFlyBV"
            currentBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            currentBV.Velocity = Vector3.new(0, 0, 0)
            currentBV.Parent = root
            
            currentBG = Instance.new("BodyGyro")
            currentBG.Name = "XenoFlyBG"
            currentBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            currentBG.CFrame = root.CFrame
            currentBG.Parent = root
        end
    else
        FlyBtn.Text = "Fly Mode: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
        if root then
            if root:FindFirstChild("XenoFlyBV") then root.XenoFlyBV:Destroy() end
            if root:FindFirstChild("XenoFlyBG") then root.XenoFlyBG:Destroy() end
        end
        if currentBV then currentBV:Destroy() currentBV = nil end
        if currentBG then currentBG:Destroy() currentBG = nil end
    end
end

FlyBtn.MouseButton1Click:Connect(function()
    _G.Config.FlyMode = not _G.Config.FlyMode
    toggleFly()
end)

task.spawn(function()
    while _G.ScriptRunning and task.wait(0.01) do
        if _G.Config.FlyMode and currentBV and currentBG then
            pcall(function()
                local char = Player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if char and hum then
                    currentBG.CFrame = workspace.CurrentCamera.CFrame
                    if hum.MoveDirection.Magnitude > 0 then
                        currentBV.Velocity = workspace.CurrentCamera.CFrame.LookVector * _G.Config.FlySpeed
                    else
                        currentBV.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end
    end
end)

