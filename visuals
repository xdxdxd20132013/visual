-- Функція глобальної зміни шрифту (Чит + БФ + Ігровий Чат)
local function applyFontToAllGame(fontName)
    local selectedEnum = Enum.Font[fontName]
    if not selectedEnum then return end
    _G.Config.SelectedFont = fontName

    -- Застосовуємо до нашого читу, оригінального UI Blox Fruits та ігрового чату
    local targets = {game:GetService("CoreGui"), game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")}
    for _, container in pairs(targets) do
        for _, obj in pairs(container:GetDescendants()) do
            if (obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox")) and obj.Name ~= "XenoToggleBtn" then
                obj.Font = selectedEnum
            end
        end
    end
end

