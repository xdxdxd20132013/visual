-- Зберігаємо початкові матеріали та кольори для вимкнення сірого неба
local originalMaterials = {}

-- 1. ЛОКАЛЬНИЙ ЧАС (День / Ніч / Класичний)
local function applyVisualTime()
    if _G.Config.VisualTime == "Day" then
        Lighting.ClockTime = 14
    elseif _G.Config.VisualTime == "Night" then
        Lighting.ClockTime = 0
    end
end

