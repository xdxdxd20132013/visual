-- 1. СИСТЕМА ЛОКАЛЬНОЇ ЗМІНИ ШРИФТІВ (Тільки для меню)
local function applyFontToMenu(fontName)
    local selectedEnum = Enum.Font[fontName]
    if not selectedEnum then return end
    
    _G.Config.SelectedFont = fontName
    saveSettings()

    -- Оновлюємо шрифт усіх текстових елементів всередині меню
    Title.Font = selectedEnum
    ToggleMenuBtn.Font = selectedEnum
    CheatsTabBtn.Font = selectedEnum
    VisualTabBtn.Font = selectedEnum
    FontTabBtn.Font = selectedEnum
    SettingsTabBtn.Font = selectedEnum
    SpeedTitle.Font = selectedEnum
    SpeedInput.Font = selectedEnum
    
    -- Шрифт кнопок
    for _, obj in pairs(MainFrame:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("TextBox") then
            obj.Font = selectedEnum
        end
    end
end

