-- Funkce pro přepínání záložek
local function switchTab(activeFrame, activeBtn)
    CheatsFrame.Visible = (activeFrame == CheatsFrame)
    VisualFrame.Visible = (activeFrame == VisualFrame)
    SettingsFrame.Visible = (activeFrame == SettingsFrame)
    
    CheatsTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    VisualTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    SettingsTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
end

CheatsTabBtn.MouseButton1Click:Connect(function() switchTab(CheatsFrame, CheatsTabBtn) end)
VisualTabBtn.MouseButton1Click:Connect(function() switchTab(VisualFrame, VisualTabBtn) end)
SettingsTabBtn.MouseButton1Click:Connect(function() switchTab(SettingsFrame, SettingsTabBtn) end)
