-- 5. ВИПРАВЛЕНИЙ ПОЛІТ (Глобальні змінні для точного відстеження в циклі руху)
_G.ActiveXenoBV = nil
_G.ActiveXenoBG = nil

local function toggleFly()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if _G.Config.FlyMode then
        FlyBtn.Text = "Fly Mode: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        if root then
            -- Створюємо левітацію
            _G.ActiveXenoBV = Instance.new("BodyVelocity")
            _G.ActiveXenoBV.Name = "XenoFlyBV"
            _G.ActiveXenoBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            _G.ActiveXenoBV.Velocity = Vector3.new(0, 0, 0)
            _G.ActiveXenoBV.Parent = root
            
            -- Створюємо кут тримання камери
            _G.ActiveXenoBG = Instance.new("BodyGyro")
            _G.ActiveXenoBG.Name = "XenoFlyBG"
            _G.ActiveXenoBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            _G.ActiveXenoBG.CFrame = root.CFrame
            _G.ActiveXenoBG.Parent = root
        end
    else
        FlyBtn.Text = "Fly Mode: OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
        if root then
            if root:FindFirstChild("XenoFlyBV") then root.XenoFlyBV:Destroy() end
            if root:FindFirstChild("XenoFlyBG") then root.XenoFlyBG:Destroy() end
        end
        if _G.ActiveXenoBV then _G.ActiveXenoBV:Destroy() _G.ActiveXenoBV = nil end
        if _G.ActiveXenoBG then _G.ActiveXenoBG:Destroy() _G.ActiveXenoBG = nil end
    end
end

FlyBtn.MouseButton1Click:Connect(function()
    _G.Config.FlyMode = not _G.Config.FlyMode
    toggleFly()
end)

-- Спільний цикл руху тепер гарантовано бачить глобальні _G.ActiveXeno змінні
task.spawn(function()
    while _G.ScriptRunning and task.wait(0.01) do
        if _G.Config.FlyMode and _G.ActiveXenoBV and _G.ActiveXenoBG then
            pcall(function()
                local char = Player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if char and hum then
                    _G.ActiveXenoBG.CFrame = workspace.CurrentCamera.CFrame
                    if hum.MoveDirection.Magnitude > 0 then
                        _G.ActiveXenoBV.Velocity = workspace.CurrentCamera.CFrame.LookVector * _G.Config.FlySpeed
                    else
                        _G.ActiveXenoBV.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end
    end
end)

